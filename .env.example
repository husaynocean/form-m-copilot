# Which model backend to use: meta | baseten | openai-compatible
LLM_PROVIDER=meta

# Meta Model API (https://dev.meta.ai)
META_API_KEY=
META_MODEL=muse-spark-1.3

# Baseten Model APIs (Muse Spark Open, open weights)
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Any OpenAI-compatible server. The live demo uses Google Gemini:
#   OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_COMPAT_MODEL=gemini-3.5-flash-lite
#   OPENAI_COMPAT_FALLBACK_MODELS=gemini-3.1-flash-lite
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Optional, comma-separated: tried in order when a model is busy or over quota
OPENAI_COMPAT_FALLBACK_MODELS=

# WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Supabase (WhatsApp session store; server-side secret key)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
